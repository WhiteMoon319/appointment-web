{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "appointment-web",
  "compatibility_date": "2026-06-29",
  "observability": {
    "enabled": true
  },
  "pages_build_output_dir": ".",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "appointment-db",
      "database_id": "REPLACE_WITH_YOUR_D1_ID"
    }
  ],
  "vars": {
    "TEACHER_INVITE_CODE": "REPLACE_WITH_SECRET",
    "NOTIFY_GROUP_ID": "REPLACE_WITH_QQ_GROUP_ID",
    "ONEBOT_URL": "https://onebot.example.com",
    "ONEBOT_TOKEN": "REPLACE_WITH_ONEBOT_TOKEN"
  }
}
